#!/usr/bin/env ruby

# Read-only report of OntologySubmission resources that have lost their link to an ontology:
# typed submissions with no `ontology` triple, `ontology` triples pointing at a missing
# ontology, and triples left in the submission graph with no rdf:type. Also lists Metrics
# resources whose submission is gone. See OrphanedSubmissionsReport below.
#
# Nothing is changed in the triplestore or the repository folder, so this is safe to run on
# any environment. API keys in stored values are masked.
#
#   bin/ncbo_orphaned_submissions
#   bin/ncbo_orphaned_submissions -o CDAO,EMAPA --details
#   bin/ncbo_orphaned_submissions --csv orphans.csv
#
# Exits 1 when an orphan blocks new submissions of an ontology, 0 otherwise.

# Everything is in this file; tests load it without running the command line.

require 'logger'
require 'set'

# Read-only report of OntologySubmission resources that have lost their link to an ontology.
#
# Goo can't find these by walking ontologies: an ontology's submissions are the resources whose
# `ontology` triple points at it, and Goo only loads resources that have an rdf:type. So this
# reads the submission graph directly and works out three kinds of orphan:
#
#   :unlinked  typed submission with no `ontology` triple (Goo loads it with ontology = nil)
#   :dangling  `ontology` triple pointing at an Ontology resource that doesn't exist
#   :untyped   triples left in the submission graph with no rdf:type (left behind by a delete)
#
# Each orphan's effect on its ontology is judged against the highest submissionId still linked
# to that ontology, which is what Ontology#next_submission_id counts:
#
#   :blocks_next_submission  typed, and holds the next id: Goo rejects every new submission
#                            (pull or upload) as a duplicate
#   :blocks_later            typed, above the next id: blocks once the ontology gets there
#   :merges_into_new         untyped, at or above the next id: its triples will be added to the
#                            new submission that gets this id
#   :ontology_deleted        the ontology it belongs to no longer exists
#   :none                    below the highest id, so no new submission will reuse it
#
# Metrics resources whose submission is no longer a typed submission are reported as well.
# Nothing is written to the triplestore or the repository folder.
class OrphanedSubmissionsReport
  KINDS = %i[unlinked dangling untyped].freeze
  PAGE_SIZE = 10_000
  SUBMISSION_PATH = %r{/ontologies/([^/]+)/submissions/([^/]+)\z}.freeze

  Orphan = Struct.new(:id, :acronym, :submission_id, :kind, :effect, :ontology_id, :ontology_exists,
                      :highest_linked_id, :triples, :upload_file_paths, :folder, :folder_exists,
                      keyword_init: true) do
    def upload_files
      upload_file_paths.map { |path| [path, File.exist?(path)] }
    end

    def statuses
      objects_of(OrphanedSubmissionsReport.submission_uri(:submissionStatus)).map { |s| s.to_s.split('/').last }
    end

    def creation_date
      objects_of(OrphanedSubmissionsReport.submission_uri(:creationDate)).first&.to_s
    end

    def objects_of(predicate)
      triples.select { |p, _| p == predicate }.map(&:last)
    end

    def to_s
      files = upload_files.map { |path, exists| "#{path} (#{exists ? 'exists' : 'missing'})" }
      [
        "#{acronym}/#{submission_id}",
        kind,
        effect,
        "ontology #{ontology_exists ? 'exists' : 'missing'}",
        "highest linked id #{highest_linked_id || '-'}",
        "#{triples.length} triples",
        "status #{statuses.empty? ? '-' : statuses.join('|')}",
        "created #{creation_date || '-'}",
        "folder #{folder_exists ? 'exists' : 'missing'}",
        "uploadFilePath #{files.empty? ? '-' : files.join(', ')}"
      ].join('  ')
    end
  end

  Result = Struct.new(:subject_count, :typed_count, :linked_count, :orphans, :orphaned_metrics,
                      keyword_init: true) do
    def by_kind(kind)
      orphans.select { |o| o.kind == kind }
    end

    def by_effect(effect)
      orphans.select { |o| o.effect == effect }
    end
  end

  def self.submission_uri(attr)
    LinkedData::Models::OntologySubmission.attribute_uri(attr)
  end

  def initialize(logger: Logger.new($stdout), repository_folder: LinkedData.settings.repository_folder,
                 page_size: PAGE_SIZE)
    @logger = logger
    @repository_folder = repository_folder.to_s
    @page_size = page_size
  end

  # acronyms: only report orphans of these ontologies (the whole graph is still scanned)
  def run(acronyms: nil)
    wanted = acronyms&.map(&:upcase)&.to_set
    submission_graph = LinkedData::Models::OntologySubmission.uri_type

    subjects = select_column(submission_graph, '?s ?p ?o', :s, distinct: true)
    typed = select_column(submission_graph, "?s a <#{submission_graph}>", :s, distinct: true)
    links = select_pairs(submission_graph, "?s <#{self.class.submission_uri(:ontology)}> ?o", :s, :o)
    ids = select_pairs(submission_graph, "?s <#{self.class.submission_uri(:submissionId)}> ?o", :s, :o)
    ontologies = select_column(LinkedData::Models::Ontology.uri_type,
                               "?s a <#{LinkedData::Models::Ontology.uri_type}>", :s, distinct: true)
    @logger.info("Submission graph: #{subjects.size} subjects, #{typed.size} typed, #{links.size} with an ontology link")

    highest = highest_linked_ids(typed, links, ids, ontologies)
    orphans = []
    subjects.each do |subject|
      kind = classify(subject, typed, links, ontologies)
      next unless kind

      orphan = build_orphan(subject, kind, links, ontologies, highest)
      next if wanted && !wanted.include?(orphan.acronym.to_s.upcase)

      orphans << orphan
    end
    orphans.sort_by! { |o| [o.acronym.to_s, o.submission_id.to_i, o.id] }

    metrics = orphaned_metrics(typed)
    metrics.select! { |m| wanted.include?(acronym_of(m.sub(%r{/metrics\z}, '')).to_s.upcase) } if wanted

    Result.new(subject_count: subjects.size, typed_count: typed.size, linked_count: links.size,
               orphans: orphans, orphaned_metrics: metrics)
  end

  def self.mask(text)
    text.to_s.gsub(/(apikey=)[^&\s"']+/i, '\1***')
  end

  private

  def classify(subject, typed, links, ontologies)
    return :untyped unless typed.include?(subject)
    targets = links[subject]
    return :unlinked if targets.nil? || targets.empty?
    return :dangling unless targets.any? { |o| ontologies.include?(o) }

    nil
  end

  def build_orphan(subject, kind, links, ontologies, highest)
    acronym, submission_id = parse_id(subject)
    ontology_id = (links[subject]&.first) || subject.sub(%r{/submissions/[^/]+\z}, '')
    ontology_exists = ontologies.include?(ontology_id)
    highest_id = highest[ontology_id]
    triples = subject_triples(subject)
    upload_paths = triples.select { |p, _| p == self.class.submission_uri(:uploadFilePath) }.map { |_, o| o.to_s }
    folder = acronym && submission_id ? File.join(@repository_folder, acronym, submission_id) : nil

    Orphan.new(id: subject, acronym: acronym, submission_id: submission_id, kind: kind,
               effect: effect(kind, submission_id, ontology_exists, highest_id),
               ontology_id: ontology_id, ontology_exists: ontology_exists, highest_linked_id: highest_id,
               triples: triples, upload_file_paths: upload_paths,
               folder: folder, folder_exists: folder ? Dir.exist?(folder) : false)
  end

  def effect(kind, submission_id, ontology_exists, highest_id)
    return :ontology_deleted unless ontology_exists
    return :none unless submission_id.to_s.match?(/\A\d+\z/)

    next_id = (highest_id || 0) + 1
    id = submission_id.to_i
    return :none if id < next_id
    return :merges_into_new if kind == :untyped

    id == next_id ? :blocks_next_submission : :blocks_later
  end

  # Same rule as Ontology#next_submission_id: only typed submissions linked to the ontology count
  def highest_linked_ids(typed, links, ids, ontologies)
    highest = {}
    links.each do |subject, targets|
      next unless typed.include?(subject)

      id = ids[subject]&.map { |v| Integer(v.to_s, exception: false) }&.compact&.max
      next unless id

      targets.each do |ont|
        next unless ontologies.include?(ont)

        highest[ont] = id if highest[ont].nil? || id > highest[ont]
      end
    end
    highest
  end

  def orphaned_metrics(typed)
    metrics_graph = LinkedData::Models::Metric.uri_type
    select_column(metrics_graph, '?s ?p ?o', :s, distinct: true)
      .select { |m| m.end_with?('/metrics') && !typed.include?(m.sub(%r{/metrics\z}, '')) }
      .sort
  end

  def parse_id(subject)
    match = SUBMISSION_PATH.match(subject)
    match ? [match[1], match[2]] : [nil, nil]
  end

  def acronym_of(subject)
    parse_id(subject).first
  end

  def subject_triples(subject)
    graph = LinkedData::Models::OntologySubmission.uri_type
    query = "SELECT ?p ?o WHERE { GRAPH <#{graph}> { <#{subject}> ?p ?o } }"
    Goo.sparql_query_client.query(query).map { |s| [s[:p], s[:o]] }
                                 .sort_by { |p, o| [p.to_s, o.to_s] }
  end

  # Distinct IRI values of one variable, as a Set of strings
  def select_column(graph, pattern, var, distinct: false)
    values = Set.new
    page(graph, pattern, [var], distinct) do |solution|
      value = solution[var]
      values << value.to_s if value.is_a?(RDF::URI)
    end
    values
  end

  # subject string => array of object values (IRIs as strings, literals as-is)
  def select_pairs(graph, pattern, subject_var, object_var)
    pairs = Hash.new { |h, k| h[k] = [] }
    page(graph, pattern, [subject_var, object_var], false) do |solution|
      subject = solution[subject_var]
      next unless subject.is_a?(RDF::URI)

      object = solution[object_var]
      pairs[subject.to_s] << (object.is_a?(RDF::URI) ? object.to_s : object)
    end
    pairs.default_proc = nil
    pairs
  end

  def page(graph, pattern, vars, distinct)
    projection = vars.map { |v| "?#{v}" }.join(' ')
    offset = 0
    loop do
      query = "SELECT #{'DISTINCT ' if distinct}#{projection} WHERE { GRAPH <#{graph}> { #{pattern} } } " \
              "ORDER BY #{projection} LIMIT #{@page_size} OFFSET #{offset}"
      count = 0
      Goo.sparql_query_client.query(query).each_solution do |solution|
        count += 1
        yield solution
      end
      break if count < @page_size

      offset += @page_size
    end
  end
end

if $PROGRAM_NAME == __FILE__
  require 'csv'

  # Exit cleanly from an early interrupt
  Signal.trap("INT") { exit 1 }

  require 'bundler/setup'
  require 'optparse'

  options = { ontologies: nil, details: false, csv: nil, logfile: nil }
  OptionParser.new do |opts|
    opts.banner = "Usage: #{File.basename(__FILE__)} [options]"
    opts.on('-o', '--ontologies ACRONYM[,ACRONYM,...]', 'Only report orphans of these ontologies (default: all)') do |acronyms|
      options[:ontologies] = acronyms.split(',').map(&:strip).reject(&:empty?)
    end
    opts.on('-d', '--details', 'Also print every triple of each orphan') { options[:details] = true }
    opts.on('-c', '--csv FILE', 'Also write one row per orphan to FILE') { |file| options[:csv] = file }
    opts.on('-l', '--logfile FILE', 'Also write the log to FILE') { |file| options[:logfile] = file }
    opts.on('-h', '--help', 'Display this screen') do
      puts opts
      exit
    end
  end.parse!

  require_relative '../lib/ncbo_cron'
  config_exists = File.exist?(File.expand_path('../../config/config.rb', __FILE__))
  abort("Please create a config/config.rb file using the config/config.rb.sample as a template") unless config_exists
  require_relative '../config/config'

  outputs = [$stdout]
  outputs << File.open(options[:logfile], 'a') if options[:logfile]
  logger = Logger.new(Class.new {
    define_method(:write) { |msg| outputs.each { |o| o.write(msg); o.flush } }
    define_method(:close) { outputs.drop(1).each(&:close) }
  }.new)

  Report = OrphanedSubmissionsReport
  mask = ->(text) { Report.mask(text) }

  logger.info("Triplestore: #{LinkedData.settings.goo_host}, repository: #{LinkedData.settings.repository_folder}")
  result = Report.new(logger: logger).run(acronyms: options[:ontologies])

  Report::KINDS.each do |kind|
    orphans = result.by_kind(kind)
    logger.info("#{kind}: #{orphans.length}")
    orphans.each do |orphan|
      logger.info("  #{mask.call(orphan)}")
      next unless options[:details]

      orphan.triples.each { |p, o| logger.info("      <#{p}> #{mask.call(o.respond_to?(:to_ntriples) ? o.to_ntriples : o)}") }
    end
  end

  effects = result.orphans.group_by(&:effect).transform_values(&:length)
  logger.info("By effect: #{effects.empty? ? 'none' : effects.map { |k, v| "#{k}=#{v}" }.join(', ')}")
  logger.info("Orphaned metrics: #{result.orphaned_metrics.length}")
  result.orphaned_metrics.each { |m| logger.info("  #{m}") } if options[:details]

  if options[:csv]
    CSV.open(options[:csv], 'w') do |csv|
      csv << %w[id acronym submission_id kind effect ontology_exists highest_linked_id triples
                status creation_date folder folder_exists upload_file_paths]
      result.orphans.each do |o|
        files = o.upload_files.map { |path, exists| "#{path}#{exists ? '' : ' (missing)'}" }.join(' | ')
        csv << [o.id, o.acronym, o.submission_id, o.kind, o.effect, o.ontology_exists, o.highest_linked_id,
                o.triples.length, o.statuses.join('|'), o.creation_date, o.folder, o.folder_exists, mask.call(files)]
      end
    end
    logger.info("Wrote #{result.orphans.length} rows to #{options[:csv]}")
  end

  blocking = result.by_effect(:blocks_next_submission)
  unless blocking.empty?
    logger.error("#{blocking.length} orphans block new submissions: #{blocking.map { |o| "#{o.acronym}/#{o.submission_id}" }.join(', ')}")
    exit 1
  end
end
